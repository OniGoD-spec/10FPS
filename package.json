{
  "name": "frame-runner-desktop",
  "productName": "Frame Runner",
  "version": "1.0.0",
  "private": true,
  "description": "Turn an ordered ZIP of images into an MP4 at the FPS you choose.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@remotion/player": "4.0.520",
    "@remotion/web-renderer": "4.0.520",
    "express": "5.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.520",
    "unzipper": "0.12.3"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/unzipper": "0.10.11",
    "@vitejs/plugin-react": "5.0.2",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "7.1.3"
  },
  "build": {
    "appId": "com.framerunner.desktop",
    "productName": "Frame Runner",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Frame Runner",
      "artifactName": "Frame-Runner-Setup-${version}-${arch}.${ext}",
      "runAfterFinish": true
    }
  }
}
